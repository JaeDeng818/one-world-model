"""
=========================================================
JAE WORLD MODEL v6.0
AI Civilization / World System Simulation Engine
=========================================================

Core:
    World
      ├── Finance
      ├── Energy
      ├── Supply Chain
      ├── Military
      └── Information

AI Subjectization:
    Tool
      ↓
    Agent
      ↓
    Subject
      ↓
    Network
      ↓
    Recursive Network

ASI v2.0:
    U  = Autonomy
    A  = Authority
    C  = Capability
    N  = Network Connectivity
    D  = Decision Density
    H  = Human Control Gap
    R  = Recursive Autonomy
    X  = Cross-System Coupling
    I  = Irreversibility

v3-ready:
    T  = Subjectization Velocity
    F  = Feedback Intensity

=========================================================
"""

from __future__ import annotations

from dataclasses import dataclass, field, asdict
from enum import Enum
from typing import Dict, List, Tuple, Optional
import json
import math
import random
from copy import deepcopy


# =========================================================
# 1. SYSTEM DEFINITIONS
# =========================================================

class WorldSystem(str, Enum):
    FINANCE = "金融"
    ENERGY = "能源"
    SUPPLY_CHAIN = "供应链"
    MILITARY = "军事"
    INFORMATION = "信息"


SYSTEMS = list(WorldSystem)


# =========================================================
# 2. ASI v2.0 WEIGHTS
# =========================================================

ASI_WEIGHTS = {
    "U": 0.18,   # Autonomy
    "A": 0.12,   # Authority
    "C": 0.08,   # Capability
    "N": 0.08,   # Network Connectivity
    "D": 0.07,   # Decision Density
    "H": 0.10,   # Human Control Gap
    "R": 0.15,   # Recursive Autonomy
    "X": 0.12,   # Cross-System Coupling
    "I": 0.10,   # Irreversibility
}


# =========================================================
# 3. THRESHOLDS
# =========================================================

class ASIZone(str, Enum):
    TOOL = "工具区"
    AGENT = "Agent区"
    CRITICAL = "主体化临界区"
    SUBJECT = "主体化区"
    NETWORK = "主体网络区"


THRESHOLDS = {
    ASIZone.TOOL: (0, 60),
    ASIZone.AGENT: (60, 75),
    ASIZone.CRITICAL: (75, 85),
    ASIZone.SUBJECT: (85, 92),
    ASIZone.NETWORK: (92, 100),
}


def classify_asi(score: float) -> ASIZone:
    if score < 60:
        return ASIZone.TOOL
    elif score < 75:
        return ASIZone.AGENT
    elif score < 85:
        return ASIZone.CRITICAL
    elif score < 92:
        return ASIZone.SUBJECT
    return ASIZone.NETWORK


# =========================================================
# 4. SYSTEM STATE
# =========================================================

@dataclass
class SystemState:

    name: WorldSystem

    # Core ASI v2.0 variables
    U: float
    A: float
    C: float
    N: float
    D: float
    H: float
    R: float
    X: float
    I: float

    # v3-ready variables
    T: float = 0.0
    F: float = 0.0

    # Dynamic state
    resources: float = 100.0
    stability: float = 100.0
    dependency: float = 0.0
    stress: float = 0.0

    # Historical record
    history: List[Dict] = field(default_factory=list)

    def as_dict(self):
        data = asdict(self)
        data["name"] = self.name.value
        return data


# =========================================================
# 5. INITIAL WORLD STATE
# =========================================================

def initial_system_states() -> Dict[WorldSystem, SystemState]:

    return {

        WorldSystem.FINANCE:
            SystemState(
                WorldSystem.FINANCE,
                U=78, A=76, C=90, N=94,
                D=94, H=51, R=65,
                X=96, I=88
            ),

        WorldSystem.ENERGY:
            SystemState(
                WorldSystem.ENERGY,
                U=70, A=68, C=82, N=82,
                D=80, H=38, R=57,
                X=87, I=97
            ),

        WorldSystem.SUPPLY_CHAIN:
            SystemState(
                WorldSystem.SUPPLY_CHAIN,
                U=84, A=80, C=84, N=90,
                D=96, H=58, R=72,
                X=91, I=63
            ),

        WorldSystem.MILITARY:
            SystemState(
                WorldSystem.MILITARY,
                U=76, A=73, C=87, N=85,
                D=89, H=35, R=69,
                X=88, I=95
            ),

        WorldSystem.INFORMATION:
            SystemState(
                WorldSystem.INFORMATION,
                U=90, A=69, C=88, N=98,
                D=99, H=55, R=78,
                X=94, I=58
            ),
    }


# =========================================================
# 6. ASI ENGINE
# =========================================================

class ASIEngine:

    def __init__(self, weights=None):

        self.weights = weights or deepcopy(ASI_WEIGHTS)

    def calculate(self, state: SystemState) -> float:

        values = {
            "U": state.U,
            "A": state.A,
            "C": state.C,
            "N": state.N,
            "D": state.D,
            "H": state.H,
            "R": state.R,
            "X": state.X,
            "I": state.I,
        }

        score = sum(
            values[k] * self.weights[k]
            for k in self.weights
        )

        return round(score, 2)

    def zone(self, state: SystemState):

        return classify_asi(
            self.calculate(state)
        )

    def distance_to_critical(self, state):

        score = self.calculate(state)

        return round(
            max(0, 85 - score),
            2
        )

    def rank(self, states):

        ranking = []

        for state in states.values():

            score = self.calculate(state)

            ranking.append({
                "system": state.name.value,
                "ASI": score,
                "zone": self.zone(state).value,
                "distance_to_85": self.distance_to_critical(state)
            })

        return sorted(
            ranking,
            key=lambda x: x["ASI"],
            reverse=True
        )


# =========================================================
# 7. CROSS-SYSTEM COUPLING MATRIX
# =========================================================

DEFAULT_COUPLING = {

    WorldSystem.FINANCE: {
        WorldSystem.ENERGY: 0.82,
        WorldSystem.SUPPLY_CHAIN: 0.91,
        WorldSystem.MILITARY: 0.63,
        WorldSystem.INFORMATION: 0.88,
    },

    WorldSystem.ENERGY: {
        WorldSystem.FINANCE: 0.82,
        WorldSystem.SUPPLY_CHAIN: 0.86,
        WorldSystem.MILITARY: 0.77,
        WorldSystem.INFORMATION: 0.71,
    },

    WorldSystem.SUPPLY_CHAIN: {
        WorldSystem.FINANCE: 0.91,
        WorldSystem.ENERGY: 0.86,
        WorldSystem.MILITARY: 0.72,
        WorldSystem.INFORMATION: 0.84,
    },

    WorldSystem.MILITARY: {
        WorldSystem.FINANCE: 0.63,
        WorldSystem.ENERGY: 0.77,
        WorldSystem.SUPPLY_CHAIN: 0.72,
        WorldSystem.INFORMATION: 0.89,
    },

    WorldSystem.INFORMATION: {
        WorldSystem.FINANCE: 0.88,
        WorldSystem.ENERGY: 0.71,
        WorldSystem.SUPPLY_CHAIN: 0.84,
        WorldSystem.MILITARY: 0.89,
    }
}


class CouplingEngine:

    def __init__(self, matrix=None):

        self.matrix = matrix or deepcopy(
            DEFAULT_COUPLING
        )

    def influence(
        self,
        source: WorldSystem,
        target: WorldSystem,
        intensity: float
    ) -> float:

        coefficient = self.matrix.get(
            source, {}
        ).get(target, 0)

        return intensity * coefficient

    def systemic_coupling(
        self,
        system: WorldSystem
    ) -> float:

        connections = self.matrix.get(system, {})

        if not connections:
            return 0

        return round(
            sum(connections.values())
            / len(connections)
            * 100,
            2
        )


# =========================================================
# 8. AI SUBJECTIZATION MODEL
# =========================================================

class AIPhase(str, Enum):

    TOOL = "Tool"
    AGENT = "Agent"
    SUBJECT = "Subject"
    NETWORK = "Network"
    RECURSIVE_NETWORK = "Recursive Network"


def determine_ai_phase(
    state: SystemState,
    asi: float
) -> AIPhase:

    if asi < 60:
        return AIPhase.TOOL

    if asi < 75:
        return AIPhase.AGENT

    if asi < 85:
        return AIPhase.SUBJECT

    if asi < 92:
        return AIPhase.NETWORK

    return AIPhase.RECURSIVE_NETWORK


# =========================================================
# 9. FEEDBACK ENGINE
# =========================================================

class FeedbackEngine:

    def calculate_feedback(
        self,
        state: SystemState,
        coupling: float
    ) -> float:

        autonomy = state.U / 100
        recursive = state.R / 100
        connectivity = state.N / 100

        feedback = (
            autonomy
            * recursive
            * connectivity
            * coupling
        )

        return round(
            min(feedback * 100, 100),
            2
        )

    def apply_feedback(
        self,
        state: SystemState,
        feedback: float
    ):

        # Feedback increases autonomy pressure
        delta_u = feedback * 0.03
        delta_r = feedback * 0.025
        delta_x = feedback * 0.02

        state.U = min(100, state.U + delta_u)
        state.R = min(100, state.R + delta_r)
        state.X = min(100, state.X + delta_x)


# =========================================================
# 10. RECURSIVE AUTONOMY ENGINE
# =========================================================

class RecursiveAutonomyEngine:

    def recursion_pressure(
        self,
        state: SystemState
    ) -> float:

        return round(
            (
                state.U *
                state.A *
                state.R
            ) / 1000000,
            4
        )

    def evolve(
        self,
        state: SystemState,
        steps: int = 1
    ):

        for _ in range(steps):

            pressure = self.recursion_pressure(
                state
            )

            state.R = min(
                100,
                state.R + pressure * 0.5
            )

            state.N = min(
                100,
                state.N + pressure * 0.2
            )

            state.X = min(
                100,
                state.X + pressure * 0.25
            )


# =========================================================
# 11. WORLD MODEL
# =========================================================

class JAEWorldModel:

    def __init__(self):

        self.time = 0

        self.systems = initial_system_states()

        self.asi = ASIEngine()

        self.coupling = CouplingEngine()

        self.feedback = FeedbackEngine()

        self.recursive = RecursiveAutonomyEngine()

        self.global_history = []

    # -----------------------------------------------------
    # CURRENT SNAPSHOT
    # -----------------------------------------------------

    def snapshot(self):

        ranking = self.asi.rank(
            self.systems
        )

        snapshot = {
            "time": self.time,
            "ranking": ranking
        }

        self.global_history.append(
            deepcopy(snapshot)
        )

        return snapshot

    # -----------------------------------------------------
    # SIMULATION STEP
    # -----------------------------------------------------

    def step(self):

        self.time += 1

        # 1. Calculate feedback
        for system, state in self.systems.items():

            coupling = (
                self.coupling
                .systemic_coupling(system)
                / 100
            )

            feedback = (
                self.feedback
                .calculate_feedback(
                    state,
                    coupling
                )
            )

            state.F = feedback

            self.feedback.apply_feedback(
                state,
                feedback
            )

            self.recursive.evolve(
                state,
                steps=1
            )

        # 2. Cross-system propagation
        self.propagate()

        # 3. Calculate T
        self.calculate_velocity()

        # 4. Store state history
        for state in self.systems.values():

            state.history.append({
                "time": self.time,
                "ASI": self.asi.calculate(state),
                "U": state.U,
                "R": state.R,
                "X": state.X,
                "F": state.F
            })

        return self.snapshot()

    # -----------------------------------------------------
    # CROSS SYSTEM PROPAGATION
    # -----------------------------------------------------

    def propagate(self):

        current_asi = {
            system:
                self.asi.calculate(state)
            for system, state
            in self.systems.items()
        }

        for source in SYSTEMS:

            for target in SYSTEMS:

                if source == target:
                    continue

                influence = (
                    current_asi[source]
                    * self.coupling
                    .matrix
                    .get(source, {})
                    .get(target, 0)
                    / 100
                )

                # Convert systemic influence
                # into small state pressure
                pressure = influence * 0.002

                self.systems[target].X = min(
                    100,
                    self.systems[target].X
                    + pressure
                )

                self.systems[target].N = min(
                    100,
                    self.systems[target].N
                    + pressure * 0.5
                )

    # -----------------------------------------------------
    # SUBJECTIZATION VELOCITY
    # -----------------------------------------------------

    def calculate_velocity(self):

        for state in self.systems.values():

            history = state.history

            if len(history) < 2:

                state.T = 0
                continue

            previous = history[-1]["ASI"]

            current = self.asi.calculate(
                state
            )

            state.T = round(
                current - previous,
                4
            )

    # -----------------------------------------------------
    # RUN
    # -----------------------------------------------------

    def run(self, steps=10):

        results = []

        for _ in range(steps):

            results.append(
                self.step()
            )

        return results

    # -----------------------------------------------------
    # CRITICAL EVENTS
    # -----------------------------------------------------

    def detect_critical_events(self):

        events = []

        for state in self.systems.values():

            score = self.asi.calculate(
                state
            )

            if score >= 85:

                events.append({
                    "system": state.name.value,
                    "event":
                        "AI主体化临界突破",
                    "ASI": score
                })

            if state.R >= 85:

                events.append({
                    "system": state.name.value,
                    "event":
                        "递归自主性临界",
                    "R": round(state.R, 2)
                })

            if state.X >= 90:

                events.append({
                    "system": state.name.value,
                    "event":
                        "跨系统耦合临界",
                    "X": round(state.X, 2)
                })

        return events

    # -----------------------------------------------------
    # SYSTEM REPORT
    # -----------------------------------------------------

    def report(self):

        ranking = self.asi.rank(
            self.systems
        )

        print("\n")
        print("=" * 75)
        print("JAE WORLD MODEL v6.0")
        print("AI SUBJECTIZATION INDEX — ASI v2.0")
        print("=" * 75)

        print(
            f"Simulation Time: {self.time}"
        )

        print()

        for i, item in enumerate(
            ranking,
            start=1
        ):

            system_name = item["system"]

            state = next(
                s for s in self.systems.values()
                if s.name.value == system_name
            )

            phase = determine_ai_phase(
                state,
                item["ASI"]
            )

            print(
                f"{i}. {system_name:<8}"
                f"ASI={item['ASI']:>6.2f}"
                f" | Zone={item['zone']:<8}"
                f" | Phase={phase.value:<18}"
                f" | T={state.T:>6.3f}"
                f" | R={state.R:>6.2f}"
                f" | X={state.X:>6.2f}"
            )

        print()

        print(
            "Critical Events:"
        )

        events = (
            self.detect_critical_events()
        )

        if not events:

            print("  None")

        else:

            for event in events:

                print(
                    " ",
                    event
                )

        print("=" * 75)

    # -----------------------------------------------------
    # SAVE
    # -----------------------------------------------------

    def save(self, path="jae_world_model.json"):

        data = {

            "version":
                "JAE World Model v6.0",

            "time":
                self.time,

            "systems": {

                system.value:
                    state.as_dict()

                for system, state
                in self.systems.items()
            },

            "history":
                self.global_history,

            "coupling": {

                source.value: {

                    target.value: value

                    for target, value
                    in targets.items()

                }

                for source, targets
                in self.coupling.matrix.items()
            }
        }

        with open(
            path,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                data,
                f,
                ensure_ascii=False,
                indent=2
            )

        print(
            f"[JAE] World state saved: {path}"
        )


# =========================================================
# 12. SCENARIO ENGINE
# =========================================================

class ScenarioEngine:

    def __init__(
        self,
        world: JAEWorldModel
    ):

        self.world = world

    def apply(
        self,
        scenario: str
    ):

        if scenario == "AI_ACCELERATION":

            for state in (
                self.world.systems.values()
            ):

                state.C = min(
                    100,
                    state.C + 8
                )

                state.U = min(
                    100,
                    state.U + 10
                )

                state.R = min(
                    100,
                    state.R + 8
                )

        elif scenario == "AI_REGULATION":

            for state in (
                self.world.systems.values()
            ):

                state.A = max(
                    0,
                    state.A - 10
                )

                state.H = min(
                    100,
                    state.H + 15
                )

        elif scenario == "GLOBAL_CRISIS":

            for state in (
                self.world.systems.values()
            ):

                state.stress = min(
                    100,
                    state.stress + 25
                )

                state.I = min(
                    100,
                    state.I + 5
                )

                state.A = min(
                    100,
                    state.A + 5
                )

        elif scenario == "SYSTEM_DECOUPLING":

            for source in SYSTEMS:

                for target in SYSTEMS:

                    if source != target:

                        self.world.coupling.matrix[
                            source
                        ][target] *= 0.7

        else:

            raise ValueError(
                f"Unknown scenario: {scenario}"
            )


# =========================================================
# 13. MONTE CARLO ENGINE
# =========================================================

class MonteCarloEngine:

    def __init__(
        self,
        world_factory,
        iterations=100
    ):

        self.world_factory = world_factory

        self.iterations = iterations

    def run(
        self,
        steps=20
    ):

        results = {
            system.value: []
            for system in SYSTEMS
        }

        for _ in range(
            self.iterations
        ):

            world = self.world_factory()

            # Small uncertainty
            for state in (
                world.systems.values()
            ):

                for attr in [
                    "U", "A", "C", "N",
                    "D", "H", "R", "X", "I"
                ]:

                    value = getattr(
                        state,
                        attr
                    )

                    value += random.gauss(
                        0,
                        2
                    )

                    setattr(
                        state,
                        attr,
                        max(
                            0,
                            min(
                                100,
                                value
                            )
                        )
                    )

            world.run(steps)

            for system, state in (
                world.systems.items()
            ):

                results[
                    system.value
                ].append(
                    world.asi.calculate(
                        state
                    )
                )

        summary = {}

        for system, values in (
            results.items()
        ):

            mean = (
                sum(values)
                / len(values)
            )

            probability = sum(
                v >= 85
                for v in values
            ) / len(values)

            summary[system] = {

                "mean_ASI":
                    round(mean, 2),

                "critical_probability":
                    round(probability, 3),

                "max":
                    round(max(values), 2),

                "min":
                    round(min(values), 2)
            }

        return summary


# =========================================================
# 14. FACTORY
# =========================================================

def create_world():

    return JAEWorldModel()


# =========================================================
# 15. MAIN
# =========================================================

if __name__ == "__main__":

    world = create_world()

    # Initial report
    print("\n[JAE] Initial World Scan")

    world.report()

    # Scenario
    scenario = ScenarioEngine(
        world
    )

    scenario.apply(
        "AI_ACCELERATION"
    )

    print(
        "\n[JAE] Scenario:"
        " AI ACCELERATION"
    )

    world.report()

    # Run simulation
    print(
        "\n[JAE] Running "
        "20-step simulation..."
    )

    world.run(
        steps=20
    )

    world.report()

    # Critical events
    print(
        "\n[JAE] Critical Event Scan"
    )

    events = (
        world.detect_critical_events()
    )

    for event in events:

        print(event)

    # Monte Carlo
    print(
        "\n[JAE] Monte Carlo"
    )

    mc = MonteCarloEngine(
        create_world,
        iterations=100
    )

    result = mc.run(
        steps=20
    )

    for system, data in (
        result.items()
    ):

        print(
            f"{system}: "
            f"mean={data['mean_ASI']}, "
            f"P(ASI>=85)="
            f"{data['critical_probability']}"
        )

    # Save
    world.save(
        "jae_world_model_v6.json"
    )