            "D": 0.15,
        },

        WorldSystem.INFORMATION: {
            "N": 0.35,
            "D": 0.20,
        },
    },


    WorldSystem.ENERGY: {

        WorldSystem.FINANCE: {
            "I": 0.30,
            "C": 0.15,
        },

        WorldSystem.SUPPLY_CHAIN: {
            "C": 0.35,
            "N": 0.30,
            "I": 0.25,
        },

        WorldSystem.MILITARY: {
            "C": 0.25,
            "I": 0.20,
        },

        WorldSystem.INFORMATION: {
            "C": 0.10,
        },
    },


    WorldSystem.SUPPLY_CHAIN: {

        WorldSystem.FINANCE: {
            "I": 0.20,
            "D": 0.15,
        },

        WorldSystem.ENERGY: {
            "C": 0.20,
            "I": 0.20,
        },

        WorldSystem.MILITARY: {
            "C": 0.35,
            "D": 0.20,
            "I": 0.25,
        },

        WorldSystem.INFORMATION: {
            "N": 0.25,
            "D": 0.20,
        },
    },


    WorldSystem.MILITARY: {

        WorldSystem.FINANCE: {
            "A": 0.20,
