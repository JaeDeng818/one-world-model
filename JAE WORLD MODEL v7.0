"""
=========================================================
JAE WORLD MODEL v7.0
TRUE WORLD MODEL / WORLD EVOLUTION ENGINE
=========================================================

从 v6.1 → v7.0 的核心升级：

[UPGRADE-1]  ASI 不再只是静态指数，而成为动态状态的一部分
[UPGRADE-2]  引入 Causal World Graph（因果世界图）
[UPGRADE-3]  跨系统传播不再统一修改 X/N，而是进入具体变量
[UPGRADE-4]  引入非线性临界动力学
[UPGRADE-5]  Phase-dependent dynamics
[UPGRADE-6]  引入 Event Shock Engine
[UPGRADE-7]  引入 Cascade / Failure Propagation
[UPGRADE-8]  引入 Civilization Survival Index (CSI)
[UPGRADE-9]  Monte Carlo 同时扰动初值、参数、事件
[UPGRADE-10] 世界状态从“ASI排序”升级为“文明演化轨迹”

核心问题：

    AI 会不会主体化？
    系统之间如何互相放大？
    世界什么时候进入临界？
    临界之后是否发生级联？
    一个文明为什么能够长期存活？

=========================================================
"""

from __future__ import annotations

from dataclasses import dataclass, field, asdict
from enum import Enum
from copy import deepcopy
from typing import Dict, List, Optional
import json
import math
import random


# =========================================================
# 1. WORLD SYSTEMS
# =========================================================

class WorldSystem(str, Enum):
    FINANCE = "金融"
    ENERGY = "能源"
    SUPPLY_CHAIN = "供应链"
    MILITARY = "军事"
    INFORMATION = "信息"


SYSTEMS = list(WorldSystem)


# =========================================================
# 2. AI SUBJECTIZATION
# =========================================================

class ASIZone(str, Enum):
    TOOL = "工具区"
    AGENT = "Agent区"
    CRITICAL = "主体化临界区"
    SUBJECT = "主体化区"
    NETWORK = "主体网络区"


ZONE_BANDS = [
    (ASIZone.TOOL, 0.0, 60.0),
    (ASIZone.AGENT, 60.0, 75.0),
    (ASIZone.CRITICAL, 75.0, 85.0),
    (ASIZone.SUBJECT, 85.0, 92.0),
    (ASIZone.NETWORK, 92.0, 100.0),
]


class AIPhase(str, Enum):
    TOOL = "Tool"
    AGENT = "Agent"
    CRITICAL = "Critical"
    SUBJECT = "Subject"
    NETWORK = "Network"


PHASE_BY_ZONE = {
    ASIZone.TOOL: AIPhase.TOOL,
    ASIZone.AGENT: AIPhase.AGENT,
    ASIZone.CRITICAL: AIPhase.CRITICAL,
    ASIZone.SUBJECT: AIPhase.SUBJECT,
    ASIZone.NETWORK: AIPhase.NETWORK,
}


def classify_asi(score: float) -> ASIZone:

    for zone, low, high in ZONE_BANDS:
        if low <= score < high:
            return zone

    return ASIZone.NETWORK


def determine_ai_phase(score: float) -> AIPhase:

    return PHASE_BY_ZONE[classify_asi(score)]


# =========================================================
# 3. ASI WEIGHTS
# =========================================================

ASI_WEIGHTS = {

    "U": 0.18,
    "A": 0.12,
    "C": 0.08,
    "N": 0.08,
    "D": 0.07,
    "H": 0.10,
    "R": 0.15,
    "X": 0.12,
    "I": 0.10,

}

assert abs(sum(ASI_WEIGHTS.values()) - 1.0) < 1e-9


# =========================================================
# 4. SYSTEM STATE
# =========================================================

@dataclass
class SystemState:

    name: WorldSystem

    # AI variables
    U: float
    A: float
    C: float
    N: float
    D: float
    H: float
    R: float
    X: float
    I: float

    # v3 / v6 variables
    T: float = 0.0
    F: float = 0.0

    # World dynamics
    resources: float = 100.0
    stability: float = 100.0
    dependency: float = 0.0
    stress: float = 0.0

    # Failure state
    failure: float = 0.0
    resilience: float = 70.0

    # Historical
    history: List[Dict] = field(default_factory=list)

    _last_asi: Optional[float] = field(
        default=None,
        repr=False,
        compare=False
    )

    def clamp(self):

        for key in [
            "U", "A", "C", "N", "D",
            "H", "R", "X", "I",
            "resources", "stability",
            "dependency", "stress",
            "failure", "resilience"
        ]:

            value = getattr(self, key)

            setattr(
                self,
                key,
                max(0.0, min(100.0, value))
            )

    def as_dict(self):

        data = asdict(self)

        data["name"] = self.name.value

        data.pop("_last_asi", None)

        return data


