# =========================================================
# 6. ASI ENGINE
# =========================================================

class ASIEngine:

    def __init__(self, weights=None):

        self.weights = deepcopy(
            weights if weights is not None
            else ASI_WEIGHTS
        )

        total = sum(self.weights.values())

        if total <= 0:
            raise ValueError(
                "ASI weights must be positive"
            )

        self.weights = {
            k: v / total
            for k, v in self.weights.items()
        }

    def calculate(self, state):

        return round(
            sum(
                getattr(state, key) * weight
                for key, weight in self.weights.items()
            ),
            2
        )

    def zone(self, state):

        return classify_asi(
            self.calculate(state)
        )

    def phase(self, state):

        return determine_ai_phase(
            self.calculate(state)
        )


# =========================================================
# 7. CAUSAL WORLD GRAPH
# =========================================================

"""
核心思想：

source system
    ↓
causal channel
    ↓
target variable

例如：

金融 → 供应链
    影响 N / D / I

能源 → 供应链
    影响 C / N / I

信息 → 军事
    影响 U / R / D

军事 → 信息
    影响 A / N / I

"""

DEFAULT_CAUSAL_GRAPH = {

    WorldSystem.FINANCE: {

        WorldSystem.ENERGY: {
            "N": 0.25,
            "D": 0.15,
            "I": 0.10,
        },

        WorldSystem.SUPPLY_CHAIN: {
