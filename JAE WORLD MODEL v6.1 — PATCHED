class CouplingEngine:

    def __init__(self, matrix: Optional[Dict] = None):
        if matrix is None:
            self.matrix = deepcopy(DEFAULT_COUPLING)
        else:
            self.matrix = deepcopy(matrix)

    def influence(
        self,
        source: WorldSystem,
        target: WorldSystem,
        intensity: float,
    ) -> float:
        coef = self.matrix.get(source, {}).get(target, 0.0)
        return intensity * coef

    def systemic_coupling(self, system: WorldSystem) -> float:
        conns = self.matrix.get(system, {})
        if not conns:
            return 0.0
        return round(sum(conns.values()) / len(conns) * 100.0, 2)


# =========================================================
# 9. FEEDBACK ENGINE
# =========================================================

class FeedbackEngine:
    """v6.1 [FIX-6]：加入稳定性阻尼

    原版 apply_feedback 只做加法，使得 ASI 单调不减，任何参数下都会
    收敛到 100 分。现引入 stability_factor，稳定性越低，反馈增益越小，
    形成事实上的负反馈通路。
    """

    # 集中管理增益
    GAIN_U = 0.03
    GAIN_R = 0.025
    GAIN_X = 0.02
    STABILITY_DAMPING = 0.7   # 0 = 无阻尼；1 = stability=0 时反馈完全归零

    def calculate_feedback(
        self,
        state: SystemState,
        coupling: float,
    ) -> float:
        autonomy    = state.U / 100.0
        recursive   = state.R / 100.0
        connectivity = state.N / 100.0
        feedback = autonomy * recursive * connectivity * coupling
        return round(min(feedback * 100.0, 100.0), 2)

    def apply_feedback(self, state: SystemState, feedback: float) -> None:
        # v6.1：stability=100 → factor=1.0
        #       stability=50  → factor=0.65
        #       stability=0   → factor=0.30
        stability_factor = (
            1.0
            - self.STABILITY_DAMPING * (1.0 - state.stability / 100.0)
        )
        net = feedback * stability_factor

        state.U = min(100.0, state.U + net * self.GAIN_U)
        state.R = min(100.0, state.R + net * self.GAIN_R)
        state.X = min(100.0, state.X + net * self.GAIN_X)


# =========================================================
# 10. RECURSIVE AUTONOMY ENGINE
# =========================================================

class RecursiveAutonomyEngine:

    def recursion_pressure(self, state: SystemState) -> float:
        return round(
            (state.U * state.A * state.R) / 1_000_000.0,
            4,
        )

    def evolve(self, state: SystemState, steps: int = 1) -> None:
        for _ in range(steps):
            p = self.recursion_pressure(state)
            state.R = min(100.0, state.R + p * 0.5)
            state.N = min(100.0, state.N + p * 0.2)
            state.X = min(100.0, state.X + p * 0.25)


# =========================================================
# 11. WORLD MODEL
# =========================================================

class JAEWorldModel:

    # v6.1：有界历史，避免长仿真内存爆掉
    HISTORY_CAP        = 500
    GLOBAL_HISTORY_CAP = 200

    # v6.1 [FIX-3]：传播增益集中管理
    PROPAGATION_GAIN = 0.8

    def __init__(self):
        self.time = 0

        self.systems = initial_system_states()

        self.asi       = ASIEngine()
        self.coupling  = CouplingEngine()
        self.feedback  = FeedbackEngine()
        self.recursive = RecursiveAutonomyEngine()

        self.global_history: List[Dict] = []

        # v6.1 [FIX-7]：初始化 _last_asi
        for state in self.systems.values():
            state._last_asi = self.asi.calculate(state)

    # -----------------------------------------------------
    # SNAPSHOT
    # -----------------------------------------------------

    def snapshot(self) -> Dict:
        ranking = self.asi.rank(self.systems)
        snap = {"time": self.time, "ranking": ranking}
        self.global_history.append(deepcopy(snap))
        if len(self.global_history) > self.GLOBAL_HISTORY_CAP:
            self.global_history.pop(0)
        return snap

    # -----------------------------------------------------
    # SIMULATION STEP
    # -----------------------------------------------------

    def step(self) -> Dict:
        self.time += 1

        # 1. 反馈循环（已被 stability 阻尼调制）
        for system, state in self.systems.items():
            coupling = self.coupling.systemic_coupling(system) / 100.0
            fb = self.feedback.calculate_feedback(state, coupling)
            state.F = fb
            self.feedback.apply_feedback(state, fb)
            self.recursive.evolve(state, steps=1)

        # 2. 跨系统传播（v6.1：差值驱动，量级正确）
        self.propagate()

        # 3. 应力 / 稳定性更新（v6.1：新增负反馈）
        self.update_stress_stability()

        # 4. 主体化速度 T（v6.1：显式追踪）
        self.calculate_velocity()

        # 5. 记录历史 + 更新 _last_asi
        for state in self.systems.values():
            cur_asi = self.asi.calculate(state)
            state.history.append({
                "time":      self.time,
                "ASI":       cur_asi,
                "U":         round(state.U, 3),
                "R":         round(state.R, 3),
                "X":         round(state.X, 3),
                "F":         state.F,
                "stability": round(state.stability, 2),
                "stress":    round(state.stress, 2),
            })
            if len(state.history) > self.HISTORY_CAP:
                state.history.pop(0)
            state._last_asi = cur_asi

        return self.snapshot()

    # -----------------------------------------------------
    # CROSS-SYSTEM PROPAGATION
    # -----------------------------------------------------

    def propagate(self) -> None:
        """v6.1 [FIX-3]：差值驱动的跨系统传播

        原 v6.0：
            pressure = ASI_src * coef * 0.002 ≈ 0.0014/步
        20 步累计推动 ASI ≈ 0.014 分，耦合矩阵完全被架空。

        现改为差值驱动：
            delta    = (ASI_src - ASI_dst) / 100
            pressure = delta * coef * K

        量级提升 2~3 个数量级，且具备均值回归特性——高分系统向低分
        系统传导压力，低分系统追赶。
        """
        cur_asi = {
            s: self.asi.calculate(st)
            for s, st in self.systems.items()
        }
        K = self.PROPAGATION_GAIN

        for source in SYSTEMS:
            for target in SYSTEMS:
                if source == target:
                    continue
                coef = self.coupling.matrix.get(source, {}).get(target, 0.0)
                if coef <= 0:
                    continue
                delta = (cur_asi[source] - cur_asi[target]) / 100.0
                pressure = delta * coef * K
                tgt = self.systems[target]
                tgt.X = max(0.0, min(100.0, tgt.X + pressure))
                tgt.N = max(0.0, min(100.0, tgt.N + pressure * 0.5))

    # -----------------------------------------------------
    # STRESS / STABILITY  (v6.1 新增)
    # -----------------------------------------------------

    def update_stress_stability(self) -> None:
        """v6.1 [FIX-6]：负反馈通路

        - stress 随 ASI 超过基线 (70) 而积累
        - stability 随 stress 衰减，并缓慢恢复
        - stability 反过来阻尼 FeedbackEngine，形成闭环

        这一步把 v6.0 中静态的 stability / stress 字段激活为真实状态。
        """
        for state in self.systems.values():
            asi = self.asi.calculate(state)

            # stress 目标值：ASI 70 → 0；ASI 100 → 100
            stress_target = max(
                0.0, min(100.0, (asi - 70.0) / 30.0 * 100.0)
            )
            # 平滑追踪
            state.stress = 0.85 * state.stress + 0.15 * stress_target

            # 衰减 ∝ stress，恢复为常数
            decay = state.stress / 100.0 * 0.8
            state.stability = max(0.0, state.stability - decay)
            state.stability = min(100.0, state.stability + 0.1)

    # -----------------------------------------------------
    # SUBJECTIZATION VELOCITY
    # -----------------------------------------------------

    def calculate_velocity(self) -> None:
        """v6.1 [FIX-7]：用 _last_asi 显式追踪

        原版依赖 history[-1]["ASI"]，一旦有人在 calculate_velocity 之前
        插入 history.append，T 会静默归零。
        """
        for state in self.systems.values():
            if state._last_asi is None:
                state.T = 0.0
                continue
            current = self.asi.calculate(state)
            state.T = round(current - state._last_asi, 4)

    # -----------------------------------------------------
    # RUN
    # -----------------------------------------------------

    def run(self, steps: int = 10) -> List[Dict]:
        results = []
        for _ in range(steps):
            results.append(self.step())
        return results

    # -----------------------------------------------------
    # CRITICAL EVENTS
    # -----------------------------------------------------

    def detect_critical_events(self) -> List[Dict]:
        events = []
        for state in self.systems.values():
            score = self.asi.calculate(state)

            if score >= 85:
                events.append({
                    "system": state.name.value,
                    "event":  "AI主体化临界突破",
                    "ASI":    score,
                })

            if state.R >= 85:
                events.append({
                    "system": state.name.value,
                    "event":  "递归自主性临界",
                    "R":      round(state.R, 2),
                })

            # v6.1 [FIX-4]：X 阈值 90 → 96
            # 初值下金融 96 / 信息 94 / 供应链 91 已 ≥ 90，
            # 原阈值在第一步即对所有系统报警，信号被淹没。
            if state.X >= 96:
                events.append({
                    "system": state.name.value,
                    "event":  "跨系统耦合临界",
                    "X":      round(state.X, 2),
                })

            # v6.1：新增稳定性预警
            if state.stability < 40:
                events.append({
                    "system": state.name.value,
                    "event":  "系统稳定性预警",
                    "stability": round(state.stability, 2),
                })

        return events

    # -----------------------------------------------------
    # REPORT
    # -----------------------------------------------------

    def report(self) -> None:
        ranking = self.asi.rank(self.systems)

        print()
        print("=" * 82)
        print("JAE WORLD MODEL v6.1  (PATCHED)")
        print("AI SUBJECTIZATION INDEX — ASI v2.0")
        print("=" * 82)
        print(f"Simulation Time: {self.time}")
        print()

        for i, item in enumerate(ranking, start=1):
            system_name = item["system"]
            state = next(
                s for s in self.systems.values()
                if s.name.value == system_name
            )
            # v6.1 [FIX-2]：单一分类器，消除 zone/phase 矛盾
            phase = determine_ai_phase(item["ASI"])
            print(
                f"{i}. {system_name:<8}"
                f" ASI={item['ASI']:>6.2f}"
                f" | Zone={item['zone']:<8}"
                f" | Phase={phase.value:<9}"
                f" | T={state.T:>+6.3f}"
                f" | R={state.R:>6.2f}"
                f" | X={state.X:>6.2f}"
                f" | Stab={state.stability:>5.1f}"
            )

        print()
        print("Critical Events:")
        events = self.detect_critical_events()
        if not events:
            print("  None")
        else:
            for ev in events:
                print("  ", ev)
        print("=" * 82)

    # -----------------------------------------------------
    # SAVE
    # -----------------------------------------------------

    def save(self, path: str = "jae_world_model_v6_1.json") -> None:
        data = {
            "version": "JAE World Model v6.1",
            "time":    self.time,
            "systems": {
                system.value: state.as_dict()
                for system, state in self.systems.items()
            },
            "history": self.global_history,
            "coupling": {
                source.value: {
                    target.value: value
                    for target, value in targets.items()
                }
                for source, targets in self.coupling.matrix.items()
            },
        }
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        print(f"[JAE] World state saved: {path}")


