# =========================================================
# 7. ASI ENGINE
# =========================================================

class ASIEngine:

    def __init__(self, weights: Optional[Dict[str, float]] = None):
        if weights is None:
            self.weights = deepcopy(ASI_WEIGHTS)
        else:
            self.weights = dict(weights)
        # v6.1：自动重新归一化，避免外部注入权重导致 ASI 越界
        total = sum(self.weights.values())
        if total <= 0:
            raise ValueError("ASI weights must be positive")
        if abs(total - 1.0) > 1e-6:
            self.weights = {k: v / total for k, v in self.weights.items()}

    def calculate(self, state: SystemState) -> float:
        score = sum(
            getattr(state, k) * self.weights[k]
            for k in self.weights
        )
        return round(score, 2)

    def zone(self, state: SystemState) -> ASIZone:
        return classify_asi(self.calculate(state))

    def distance_to_critical(self, state: SystemState) -> float:
        return round(max(0.0, 85.0 - self.calculate(state)), 2)

    def rank(self, states: Dict[WorldSystem, SystemState]) -> List[Dict]:
        ranking = []
        for state in states.values():
            score = self.calculate(state)
            ranking.append({
                "system": state.name.value,
                "ASI": score,
                "zone": self.zone(state).value,
                "distance_to_85": self.distance_to_critical(state),
            })
        return sorted(ranking, key=lambda x: x["ASI"], reverse=True)


