# 12. SCENARIO ENGINE
# =========================================================

class ScenarioEngine:

    def __init__(self, world: JAEWorldModel):
        self.world = world

    def apply(self, scenario: str) -> None:

        if scenario == "AI_ACCELERATION":
            for state in self.world.systems.values():
                state.C = min(100, state.C + 8)
                state.U = min(100, state.U + 10)
                state.R = min(100, state.R + 8)

        elif scenario == "AI_REGULATION":
            # v6.1 [FIX-1]：H 是 Human Control Gap，监管应 *缩小* 缺口
            # 原 v6.0 写成 state.H += 15，导致 ASI 反而 +0.3 分。
            for state in self.world.systems.values():
                state.A = max(0, state.A - 10)
                state.H = max(0, state.H - 15)          # FIXED: was +15
                state.stability = min(100, state.stability + 10)

        elif scenario == "GLOBAL_CRISIS":
            for state in self.world.systems.values():
                state.stress    = min(100, state.stress + 25)
                state.I         = min(100, state.I + 5)
                state.A         = min(100, state.A + 5)
                state.stability = max(0,   state.stability - 20)

        elif scenario == "SYSTEM_DECOUPLING":
            for source in SYSTEMS:
                for target in SYSTEMS:
                    if source != target:
                        self.world.coupling.matrix[source][target] *= 0.7

        elif scenario == "STABILIZATION":
            # v6.1 新增：主动稳定性干预
            for state in self.world.systems.values():
                state.stability = min(100, state.stability + 25)
                state.stress    = max(0,   state.stress - 20)
                state.R         = max(0,   state.R - 5)

        else:
            raise ValueError(f"Unknown scenario: {scenario}")


# =========================================================
# 13. MONTE CARLO ENGINE
# =========================================================

class MonteCarloEngine:

    def __init__(
        self,
        world_factory,
        iterations: int = 100,
        perturb_params: bool = True,   # v6.1 [FIX-9]
        param_sigma: float = 0.05,
    ):
        self.world_factory  = world_factory
        self.iterations     = iterations
        self.perturb_params = perturb_params
        self.param_sigma    = param_sigma

    # v6.1 [FIX-9]：参数扰动采样器
    def _perturbed_weights(self) -> Dict[str, float]:
        w = {
            k: max(0.0, v + random.gauss(0, self.param_sigma))
            for k, v in ASI_WEIGHTS.items()
        }
        s = sum(w.values())
        if s <= 0:
            return deepcopy(ASI_WEIGHTS)
        return {k: v / s for k, v in w.items()}

    def _perturbed_coupling(self) -> Dict:
        m = {}
        for src, targets in DEFAULT_COUPLING.items():
            m[src] = {}
            for tgt, v in targets.items():
                nv = v + random.gauss(0, self.param_sigma)
                m[src][tgt] = max(0.0, min(1.0, nv))
        return m

    def run(self, steps: int = 20) -> Dict[str, Dict]:

        results: Dict[str, List[float]] = {s.value: [] for s in SYSTEMS}

        for _ in range(self.iterations):
            world = self.world_factory()

            # v6.1 [FIX-9]：参数扰动
            if self.perturb_params:
                world.asi      = ASIEngine(self._perturbed_weights())
                world.coupling = CouplingEngine(self._perturbed_coupling())

            # 初值扰动
            for state in world.systems.values():
                for attr in ["U", "A", "C", "N", "D", "H", "R", "X", "I"]:
                    val = getattr(state, attr) + random.gauss(0, 2)
                    setattr(state, attr, max(0.0, min(100.0, val)))
                state._last_asi = world.asi.calculate(state)

            world.run(steps)

            for system, state in world.systems.items():
                results[system.value].append(world.asi.calculate(state))

        summary: Dict[str, Dict] = {}
        for system, values in results.items():
            n = len(values)
            mean = sum(values) / n
            var  = sum((v - mean) ** 2 for v in values) / n
            p_crit = sum(v >= 85 for v in values) / n
            summary[system] = {
                "mean_ASI":             round(mean, 2),
                "std_ASI":              round(math.sqrt(var), 2),  # v6.1
                "critical_probability": round(p_crit, 3),
                "max":                  round(max(values), 2),
                "min":                  round(min(values), 2),
            }

        return summary


